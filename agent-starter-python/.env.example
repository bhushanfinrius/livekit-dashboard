LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AGENT_NAME=CTF-Agent

# Optional. Defaults to src/agent.py. Example: src/agant.py
AGENT_ENTRYPOINT=src/agent.py

# Vertex Gemini Live + GCS recordings share one SA file. Do not set GOOGLE_API_KEY
# (AIza keys route Live to Google's project-ed86b9c7 and fail with 1008).
GOOGLE_CLOUD_PROJECT=solvox-ai-007
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
GCS_SERVICE_ACCOUNT_JSON=livekit-storage.json
GOOGLE_APPLICATION_CREDENTIALS=livekit-storage.json
# GOOGLE_API_KEY=

# Concurrency (matches one agent × 10 calls on a typical 4–8 vCPU worker).
AGENT_MAX_CONCURRENT_JOBS=10
AGENT_NUM_IDLE_PROCESSES=2
AGENT_LOAD_THRESHOLD=1.0
# AGENT_JOB_MEMORY_WARN_MB=800

# Pipeline and/or realtime keys — keep whatever this agent needs.
# OPENAI_API_KEY=
# DEEPGRAM_API_KEY=
