LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AGENT_NAME=my-agent

# Optional. Defaults to src/agent.py. Example: src/agant.py
AGENT_ENTRYPOINT=src/agent.py

# Vertex / Gemini Live — India users: asia-south1 (Mumbai) for Cloud-like or better RTT.
# Only set us-central1 if the model is unavailable in asia-south1.
GOOGLE_CLOUD_PROJECT=solvox-ai-007
GOOGLE_CLOUD_LOCATION=asia-south1
# GOOGLE_API_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=solvoxai.json

# Concurrency (matches one agent × 10 calls on a typical 4–8 vCPU worker).
AGENT_MAX_CONCURRENT_JOBS=10
AGENT_NUM_IDLE_PROCESSES=2
AGENT_LOAD_THRESHOLD=1.0
# AGENT_JOB_MEMORY_WARN_MB=800

# Pipeline and/or realtime keys — keep whatever this agent needs.
# OPENAI_API_KEY=
# DEEPGRAM_API_KEY=
