LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AGENT_NAME=CTF-Agent

# Optional. Defaults to src/agent.py. Example: src/agant.py
AGENT_ENTRYPOINT=src/agent.py

# Vertex Gemini Live + GCS recordings share one SA file (livekit-storage.json).
# Project is taken from that JSON. Do not set GOOGLE_API_KEY.
GOOGLE_CLOUD_PROJECT=project-ed86b9c7-57a3-441d-8f9
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
GCS_SERVICE_ACCOUNT_JSON=livekit-storage.json
GOOGLE_APPLICATION_CREDENTIALS=livekit-storage.json
# GOOGLE_API_KEY=

# Concurrency (keep at least 3 idle processes so frontend concurrency=3 can start together).
AGENT_MAX_CONCURRENT_JOBS=10
AGENT_NUM_IDLE_PROCESSES=5
AGENT_LOAD_THRESHOLD=1.0
# AGENT_JOB_MEMORY_WARN_MB=800
# Unused for blocking calls. Solvox frontend owns concurrency.
# Agent only drops extra camp-* rooms for the same lead.
# CAMPAIGN_MAX_CONCURRENT=3

# Pipeline and/or realtime keys — keep whatever this agent needs.
# OPENAI_API_KEY=
# DEEPGRAM_API_KEY=
