# Remote agent deploy — copy to .deploy.env and edit.
# Like "lk agent deploy" but targets your LumiVoice VPS (not LiveKit Cloud).

# SSH target (required) — user@IP only, no http://
# Many VPS providers use root, not ubuntu:
LV_DEPLOY_HOST="root@103.191.209.120"
# Optional: path to private key (needed for npm deploy — password SSH won't work in scripts)
# LV_SSH_IDENTITY_FILE="C:/Users/YourName/.ssh/id_ed25519"
# LV_SSH_PORT="22"

# Path on the server where the git repo is cloned (required)
# Should contain livekit-dashboard/ and agent-starter-python/
LV_DEPLOY_ROOT="/opt/lumivoice"

# Git branch to pull on the server
LV_DEPLOY_BRANCH="bhushan"

# Agent identity (optional defaults — override on CLI with --name / --entrypoint)
# LV_AGENT_NAME="CTF-Agent"
# LV_AGENT_ENTRYPOINT="src/agent.py"

# VPS: use TURN + public ports overlay. Leave empty for plain docker-compose.yml.
LV_COMPOSE_EXTRA="-f docker-compose.yml -f docker-compose.vps.yml"

# Push local commits before deploy (1 = yes). Or pass: npm run agent:deploy:remote -- --push
LV_GIT_PUSH="0"

# Wait for "registered worker" after deploy (1 = yes). Or pass --wait
LV_WAIT="1"

# Secrets (STT/TTS/LLM/Vertex) stay on the VPS in:
#   /opt/lumivoice/agent-starter-python/.env.local
# Do NOT commit .env.local or copy it from your laptop each deploy.
