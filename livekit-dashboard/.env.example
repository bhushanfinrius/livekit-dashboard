# Local Postgres from docker compose (user/password/db are all "deck").
# Host port is 5433 to avoid colliding with other local Postgres instances.
# The `deck` Compose service overrides this to postgres:5432 inside the network.
DATABASE_URL="postgresql://deck:deck@localhost:5433/deck"

# Auth.js v5. Must be at least 32 characters.
# Generate a value:
#   Windows PowerShell:  [Convert]::ToBase64String([byte[]](1..32 | ForEach-Object { Get-Random -Maximum 256 }))
#   macOS / Linux:       openssl rand -base64 32
#   Any PC with Node:    node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="deck-dev-secret-replace-before-production-use-32b"
AUTH_URL="http://localhost:3000"

# Optional OAuth — leave blank to hide GitHub/Google buttons
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# AES-256-GCM key for LiveKit API secrets at rest. Same generate commands as AUTH_SECRET.
ENCRYPTION_KEY="deck-dev-encryption-key-replace-before-prod32"

# Room recordings (livekit-egress → GCS). Path to a service-account JSON.
# Example: ../agent-starter-python/livekit-storage.json
GCS_BUCKET_NAME=""
GCS_CREDENTIALS_PATH=""
# GCS_CREDENTIALS_JSON=""

# Shared secret the Python agent sends as x-deck-transcript-secret.
DECK_TRANSCRIPT_SECRET="deck-dev-transcript-secret-32chars!!"

# Local agent worker (Agents → Deploy). Official livekit-examples/agent-starter-python clone.
# Use forward slashes even on Windows. Relative path from this folder:
AGENT_BUILD_CONTEXT="../agent-starter-python"
# Agent STT/TTS/LLM/realtime keys live in the starter .env.local, not here.

# One-command stack (UI + LiveKit, no agent): npm run docker:stack
# See docs/DEPLOY.md and docs/AGENT_STARTER.md.
