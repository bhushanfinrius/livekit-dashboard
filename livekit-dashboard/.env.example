# Local Postgres from docker compose (user/password/db are all "deck").
# Host port is 5433 to avoid colliding with other local Postgres instances.
# The `deck` Compose service overrides this to postgres:5432 inside the network.
DATABASE_URL="postgresql://deck:deck@localhost:5433/deck"

# Auth.js v5. Must be at least 32 characters.
# `npm run livekit:keys` (also run by npm run docker:up) fills the REPLACE_WITH values below.
AUTH_SECRET="REPLACE_WITH_GENERATED_SECRET"
AUTH_URL="http://localhost:3000"

# Optional OAuth — leave blank to hide GitHub/Google buttons
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# AES-256-GCM key for LiveKit API secrets at rest.
# Never rotate this once projects exist: stored secrets become undecryptable.
ENCRYPTION_KEY="REPLACE_WITH_GENERATED_SECRET"

# Room recordings (livekit-egress → GCS). Path to a service-account JSON.
# Example: ../agent-starter-python/livekit-storage.json
GCS_BUCKET_NAME=""
GCS_CREDENTIALS_PATH=""
# GCS_CREDENTIALS_JSON=""

# Shared secret the Python agent sends as x-deck-transcript-secret.
DECK_TRANSCRIPT_SECRET="REPLACE_WITH_GENERATED_SECRET"

# SIP URI shown on each project's settings page. Defaults to LIVEKIT_PUBLIC_IP, then the
# LiveKit hostname. One SIP service serves every project; calls reach a project via the
# phone numbers on its inbound trunk.
SIP_PUBLIC_HOST=""
SIP_PUBLIC_PORT="5060"

# Local agent worker (Agents → Deploy). Official livekit-examples/agent-starter-python clone.
# Use this relative path when LumiVoice runs in Docker (docker compose up deck).
# For npm run dev on Windows you may use an absolute path instead.
AGENT_BUILD_CONTEXT="../agent-starter-python"
# Agent STT/TTS/LLM/realtime keys live in the starter .env.local, not here.
# For India latency set in agent .env.local: GOOGLE_CLOUD_LOCATION=asia-south1

# One-command stack (UI + LiveKit, no agent): npm run docker:stack
# VPS direct upload: cp .env.vps.example .env — see docs/VPS-AGENT-COMMANDS.md
# India / public VPS (TURN ports): npm run docker:vps  (after copying livekit.vps.example.yaml)
# See docs/DEPLOY.md, docs/VPS-DEPLOY.md, docs/PERFORMANCE.md.
