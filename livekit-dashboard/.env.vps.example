# VPS — copy to .env when livekit-dashboard and agent-starter-python are sibling folders on the server.
# Upload both folders via SFTP/rsync/scp (no git required).

DATABASE_URL="postgresql://deck:deck@postgres:5432/deck"
# `npm run livekit:keys` (also run by npm run docker:vps:up) fills these REPLACE_WITH values.
AUTH_SECRET="REPLACE_WITH_GENERATED_SECRET"
ENCRYPTION_KEY="REPLACE_WITH_GENERATED_SECRET"
DECK_TRANSCRIPT_SECRET="REPLACE_WITH_GENERATED_SECRET"

# Required, no default. The URL this dashboard is served from.
AUTH_URL="REPLACE_WITH_https://your.host"

# Required, no default. Public IP or hostname for LiveKit TURN + ICE.
LIVEKIT_PUBLIC_IP="REPLACE_WITH_public_ip_or_hostname"

# SIP URI shown on each project's settings page. Defaults to LIVEKIT_PUBLIC_IP.
SIP_PUBLIC_HOST=""
SIP_PUBLIC_PORT="5060"

# Sibling folder on VPS (default layout):
AGENT_BUILD_CONTEXT="../agent-starter-python"

# Agent secrets live in ../agent-starter-python/.env.local (never commit).
# Required file on VPS (not in git):
#   ../agent-starter-python/livekit-storage.json  (Vertex AI + GCS)

# LiveKit API keys are not here: `npm run livekit:keys` generates a pool into
# config/livekit.keys.json and each project is assigned its own pair.
