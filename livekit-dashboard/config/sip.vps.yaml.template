# Generated into config/sip.vps.yaml by: npm run livekit:keys
# Uses the infra key pair only; project keys are never given to the SIP service.
log_level: info
api_key: __LIVEKIT_INFRA_API_KEY__
api_secret: "__LIVEKIT_INFRA_API_SECRET__"
ws_url: ws://livekit:7880
redis:
  address: redis:6379
sip_port: 5060
rtp_port: 10000-10050
use_external_ip: true
health_port: 8080
