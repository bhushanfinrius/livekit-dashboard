# Generated into livekit.yaml by: npm run livekit:keys
# Secrets come from config/livekit.keys.json (gitignored). Do not put keys in this file.
port: 7880
rtc:
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 50100
  # Laptop/Docker Desktop: false. India VPS / public NIC: true (see livekit.vps.example.yaml).
  use_external_ip: false
  # Optional: pin STUN when behind unusual NAT. Defaults are fine for most VPS.
  # stun_servers:
  #   - stun.l.google.com:19302

# Built-in TURN (Cloud-like NAT traversal). Keep disabled on laptop.
# On VPS: set enabled: true, domain to public IP or hostname, open UDP/TCP 3478.
# Full example: livekit.vps.example.yaml + docker compose -f docker-compose.yml -f docker-compose.vps.yml
turn:
  enabled: false
  domain: localhost
  udp_port: 3478
  # tls_port: 5349

redis:
  address: redis:6379

# One infra pair (used by sip/egress/webhook) plus a pool assigned one-per-project.
# LiveKit reads keys only at startup, so recreate the container after changing these.
keys:
__LIVEKIT_KEYS__

webhook:
  # The infra pair signs webhooks. LumiVoice attributes events to a project by room.
  api_key: __LIVEKIT_INFRA_API_KEY__
  urls:
    # Host LumiVoice (`npm run dev`) and Compose UI (`docker compose up deck`).
    # Recreate the livekit container after changing these URLs.
    - http://host.docker.internal:3000/api/webhooks/livekit
    - http://deck:3000/api/webhooks/livekit
