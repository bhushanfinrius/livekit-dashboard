{
  "name": "deck",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "docker:up": "node scripts/docker-up.mjs",
    "docker:stack": "docker compose up -d --build postgres redis livekit sip egress deck",
    "docker:vps": "docker compose -f docker-compose.yml -f docker-compose.vps.yml up -d --build postgres redis livekit sip egress deck",
    "predev": "npm run docker:up",
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@livekit/components-react": "^2.9.24",
    "@livekit/components-styles": "^1.2.0",
    "@prisma/client": "^6.19.3",
    "@tremor/react": "^3.18.7",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "livekit-client": "^2.22.0",
    "livekit-server-sdk": "^2.18.0",
    "lucide-react": "^1.33.0",
    "next": "15.5.23",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "prisma": "^6.19.3",
    "radix-ui": "^1.6.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "react-is": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
